+// Tries to find the lens by name, possibly splitting the maker and
+// model from the lens name.
+static const lfLens **find_lens_from_name(const lfDatabase *database, const lfCamera *cam, const Glib::ustring &lens_name) {
+    auto found = database->FindLenses(cam, nullptr, lens_name.c_str());
+    for (size_t pos = 0; !found && pos < lens_name.size(); ) {
+        // try to split the maker from the model of the lens -- we have to
+        // guess a bit here, since there are makers with a multi-word name
+        // (e.g. "Leica Camera AG")
+        if (lens_name.find("f/", pos) == 0) {
+            break; // no need to search further
+        }
+        Glib::ustring make, model;
+        auto i = lens_name.find(' ', pos);
+        if (i != Glib::ustring::npos) {
+            make = lens_name.substr(0, i);
+            model = lens_name.substr(i+1);
+            found = database->FindLenses(cam, make.c_str(), model.c_str());
+            pos = i+1;
+        } else {
+            break;
+        }
+    }
+    return found;
+}
+
+std::vector<LFLens> LFDatabase::profileCandidates(const LFCamera &camera, const Glib::ustring &name) const
+{
+    std::vector<LFLens> result;
+    if (!data_ || !camera || (name.empty() && !camera.isFixedLens())) {
+        return result;
+    }
+    MyMutex::MyLock lock(lfDBMutex);
+    auto found = find_lens_from_name(data_, camera.data_, trimDashWhitespace(name.raw()));
+    if (!found && camera.isFixedLens()) {
+        found = data_->FindLenses(camera.data_, nullptr, "");
+    }
+    if (found) {
+        for (auto row = found; *row; ++row) {
+            result.emplace_back();
+            result.back().data_ = *row;
+        }
+        lf_free(found);
+    }
+    return result;
+}
