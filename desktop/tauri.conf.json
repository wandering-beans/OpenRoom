{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenRoom",
  "version": "0.7.9",
  "identifier": "local.advanced-explorer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "ui-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OpenRoom — ライブラリ",
        "width": 1320,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#080808",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "Info.plist",
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      },
      "bundleVersion": "19"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDRTY2QjkwRTg1RTg0RUIKUldUcmhGN29rR3ZtdlBNTHM1N3FEQlc4Q0lrcElFcnJhSHZ3U3VrdFo5TzEybHoyUyswdTNMUjgK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://raw.githubusercontent.com/wandering-beans/OpenRoom/main/updates/latest.json"
      ]
    }
  }
}
