{
  "name": "openroom-desktop-ui",
  "version": "0.7.8",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test:unit": "node --experimental-strip-types ../scripts/test-frontend-contracts.mjs && node --experimental-strip-types ../scripts/test-straighten.cjs && node --experimental-strip-types ../scripts/test-mask-preview.cjs",
    "test:ui": "npm run test:unit && npm run build && node ../scripts/test-desktop-ui.cjs",
    "test:language": "npm run build && node ../scripts/test-desktop-ui.cjs --language"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.58.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
